rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Invite-only allowlist. Documents here are added manually by the admin
    // via the Firebase Console (Firestore Database -> allowlist collection).
    // Document ID = lower-cased email address, e.g. "someone@example.com".
    // No one can read or write this collection from the app; it is only
    // consulted internally by the rules below via exists().
    match /allowlist/{emailId} {
      allow read, write: if false;
    }

    // Each signed-in, allowlisted user gets their own private app state.
    match /users/{uid}/app/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email.lower()));
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
