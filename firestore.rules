rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Invite-only allowlist. Documents here are added manually by the admin
    // via the Firebase Console (Firestore Database -> allowlist collection).
    // Document ID = lower-cased email address, e.g. "someone@example.com".
    // No one can read or write this collection from the app; it is only
    // consulted internally by the rules below via exists().
    match /allowlist/{emailId} {
      allow read, write: if false;
    }

    // Self-service access requests. A signed-in user with a verified email can
    // create/update ONLY their own request document (doc ID = their uid) so the
    // admin can review it in the Firebase Console and, once approved, add their
    // email to the allowlist collection above. Nobody can delete these from the
    // app (cleanup is a manual admin step) and nobody can read another user's.
    match /pending/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true;
      allow delete: if false;
    }

    // Each signed-in, allowlisted user gets their own private app state.
    match /users/{uid}/app/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email.lower()));
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
