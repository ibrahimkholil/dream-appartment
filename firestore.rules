rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // Admins. The very FIRST admin is bootstrapped manually via the Firebase
    // Console (Firestore -> admins collection, document ID = lower-cased
    // email) - a deliberate one-time step so nobody can grant themselves
    // admin from inside the app. After that, existing admins can add/remove
    // other admins from the in-app admin panel. A non-admin may still check
    // ONLY their own admin doc (to decide whether to show the panel at all).
    match /admins/{emailId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email != null
        && request.auth.token.email.lower() == emailId);
      allow create, delete: if isAdmin();
      allow update: if false;
    }

    // Access allowlist. Admins can read/manage it from the in-app admin
    // panel; everyone else (including the app's own normal read path) only
    // ever consults it indirectly via exists() below - never lists it.
    match /allowlist/{emailId} {
      allow read, write: if isAdmin();
    }

    // Self-service access requests. The requester can create/update ONLY
    // their own doc (doc ID = their uid) once their email is verified.
    // Admins can read the whole queue and delete entries (after approving
    // or rejecting) from the in-app admin panel.
    match /pending/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true;
      allow delete: if isAdmin();
    }

    // Each signed-in, allowlisted user gets their own private app state.
    // Admins always get in too (even without a separate allowlist entry) -
    // otherwise adding someone as admin wouldn't let them actually reach the
    // app to use their admin powers.
    match /users/{uid}/app/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email != null
        && (exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email.lower()))
            || isAdmin());
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
