rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Permanent owner emails, baked directly into the rules so the very
    // first admin never needs a manually-created Firestore document - only
    // this one rules deploy. Add more addresses here (comma-separated,
    // lowercase) if you want more than one permanent owner; everyone else
    // is promoted to admin from the in-app panel instead, stored normally
    // in the admins collection below.
    function isOwner() {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.email.lower() in
           ['ibrahimkhalil122@gmail.com', 'dreamapt@gmail.com'];
    }

    function isAdmin() {
      return isOwner() || (request.auth != null && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())));
    }

    // Admins beyond the permanent owners above are managed entirely from the
    // in-app admin panel (any existing admin, owner or not, can add/remove
    // others there). A non-admin may still check ONLY their own admin doc
    // (to decide whether to show the panel at all).
    match /admins/{emailId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email != null
        && request.auth.token.email.lower() == emailId);
      allow create, delete: if isAdmin();
      allow update: if false;
    }

    // Access allowlist. Admins can read/manage it from the in-app admin
    // panel; everyone else (including the app's own normal read path) only
    // ever consults it indirectly via exists() below - never lists it.
    match /allowlist/{emailId} {
      allow read, write: if isAdmin();
    }

    // Self-service access requests. The requester can create/update ONLY
    // their own doc (doc ID = their uid) once their email is verified.
    // Admins can read the whole queue and delete entries (after approving
    // or rejecting) from the in-app admin panel.
    match /pending/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true;
      allow delete: if isAdmin();
    }

    // Each signed-in, allowlisted user gets their own private app state.
    // Admins always get in too (even without a separate allowlist entry) -
    // otherwise adding someone as admin wouldn't let them actually reach the
    // app to use their admin powers.
    match /users/{uid}/app/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email != null
        && (exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email.lower()))
            || isAdmin());
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
